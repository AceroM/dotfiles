#!/usr/bin/env python3
"""Close the invoking Herdr tab or pane, keeping the same tab position."""

import json
import os
import socket
import sys


def request(method, params):
    path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser(
        "~/.config/herdr/herdr.sock"
    )
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(path)
        connection.sendall(
            (json.dumps({"id": "close_tab_in_place", "method": method, "params": params}) + "\n").encode()
        )
        with connection.makefile("r") as response_file:
            response = json.loads(response_file.readline())
    if "error" in response:
        raise RuntimeError(f"{method}: {response['error']}")
    return response["result"]


def main():
    mode = sys.argv[1] if len(sys.argv) == 2 else "tab"
    if mode not in ("tab", "pane") or len(sys.argv) > 2:
        raise ValueError("usage: herdr-close-tab-in-place [tab|pane]")

    workspace_id = os.environ["HERDR_ACTIVE_WORKSPACE_ID"]
    source_tab_id = os.environ["HERDR_ACTIVE_TAB_ID"]
    tabs = request("tab.list", {"workspace_id": workspace_id})["tabs"]
    source_index = next(
        index for index, tab in enumerate(tabs) if tab["tab_id"] == source_tab_id
    )
    next_tab_id = (
        tabs[source_index + 1]["tab_id"] if source_index + 1 < len(tabs) else None
    )
    if mode == "pane":
        close_method = "pane.close"
        close_target = {"pane_id": os.environ["HERDR_ACTIVE_PANE_ID"]}
        removes_tab = tabs[source_index]["pane_count"] == 1
        fallback = "prefix+X"
    else:
        close_method = "tab.close"
        close_target = {"tab_id": source_tab_id}
        removes_tab = True
        fallback = "prefix+Shift+X"

    try:
        request(close_method, close_target)
    except RuntimeError as error:
        if "confirmation_required" not in str(error):
            raise
        request(
            "notification.show",
            {
                "title": "Close needs confirmation",
                "body": f"Use {fallback} to close this worktree group.",
            },
        )
        return
    if removes_tab and next_tab_id is not None:
        request("tab.focus", {"tab_id": next_tab_id})


if __name__ == "__main__":
    try:
        main()
    except (KeyError, OSError, ValueError, StopIteration, RuntimeError) as error:
        print(f"herdr-close-tab-in-place: {error}", file=sys.stderr)
        sys.exit(1)
