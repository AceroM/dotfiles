#!/usr/bin/env bash
# Close the focused Herdr pane or tab at once, agents and all.
#
#   herdr-close pane [<pane_id>]   close the focused pane, or that one
#   herdr-close tab  [<tab_id>]    close the focused tab, or that one
#
# Herdr's own close (close_pane, close_tab, `herdr pane close`, `tab close`)
# sends each pane's shell SIGHUP, waits ~400ms, then escalates to SIGTERM, and
# the server answers nothing else in the meantime: the whole UI freezes until
# the pane is gone. A shell dies on the HUP at once. Claude Code ignores it,
# then runs its own graceful shutdown (MCP servers and all) on the TERM. Timed
# on 2026-11-04 with `herdr pane close`: plain shell 46ms, fresh Claude 330ms,
# a HUP-ignoring job 560ms. A tab paid that once per agent.
#
# So SIGKILL each agent's foreground process group (the agent plus its MCP
# servers and children) first, then ask Herdr to close. The shells left behind
# go on the first HUP.
#
# Only panes Herdr recognizes as agents get the KILL. Everything else still
# gets the HUP: editors preserve their buffers on it, and supervisors like
# `docker compose up` stop their children on it, where a KILL would orphan them.
#
# Skipping the agent's graceful shutdown is deliberate: there are no SessionEnd
# hooks left to run, and transcripts are appended per message, so the most a
# kill loses is a turn that was still streaming.
#
# Bound in config.toml as `type = "shell"` commands: ctrl+alt+w (fn+w) runs
# `pane`, ctrl+alt+x (fn+x) runs `tab`. The server spawns them detached, with
# no $PATH and no tty to print errors to: hence the explicit PATH and the log
# file. Every request goes straight to the socket through nc (~5ms) rather
# than through the herdr CLI (~25ms a call).
#
# Kept bash-3.2 clean: the shebang resolves against whatever PATH the server
# hands us, which may well find /bin/bash rather than homebrew's bash 5.
set -uo pipefail

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"

log_file="$HOME/.local/state/herdr-close.log"
log() {
  [ -d "${log_file%/*}" ] || mkdir -p "${log_file%/*}"
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log_file"
}
die() { log "error: $*"; printf 'herdr-close: %s\n' "$*" >&2; exit 1; }

# One request per connection: the server hangs up after its answer.
call() { # method [params-json]
  local params="${2:-}"
  [ -n "$params" ] || params='{}'
  printf '{"id":"close","method":"%s","params":%s}\n' "$1" "$params" |
    nc -U -w 2 "$sock"
}

# SIGKILL the foreground group of each agent pane given, then give the kernel
# a moment to reap them, so the close that follows meets bare shells.
killed=""
kill_agents() { # pane_id...
  local pane pgid shell_pid g groups="" alive=""
  for pane in "$@"; do
    read -r pgid shell_pid < <(call pane.process_info "{\"pane_id\":\"$pane\"}" |
      jq -r '.result.process_info | "\(.foreground_process_group_id // "") \(.shell_pid // "")"')
    # A group equal to the shell's pid means no foreground job (the agent
    # already exited to the prompt): leave the shell to the HUP.
    if [ -n "${pgid:-}" ] && [ "$pgid" != "${shell_pid:-}" ]; then
      kill -KILL -- "-$pgid" 2>/dev/null && groups="$groups $pgid"
    fi
  done
  for _ in 1 2 3 4 5; do
    alive=""
    for g in $groups; do kill -0 -- "-$g" 2>/dev/null && alive="$alive $g"; done
    [ -z "$alive" ] && break
    sleep 0.02
  done
  killed="${groups:- none}${alive:+; still alive:$alive}"
}

# When the focused tab closes, Herdr hands focus to the tab on its LEFT.
# Browser habit wants the one on the right, so focus the right-hand neighbor
# *before* the close: the tab then goes away in the background and Herdr has no
# focus to reassign. Nothing happens when the tab is not the focused one (an
# explicit id closing something in the background), when it is the last tab in
# its space (no right neighbor, so Herdr's fallback to the left stands), or,
# for a pane close, when other panes keep the tab alive.
moved=""
focus_right_of() { # tab_id [pane]   "pane": only if that is the tab's last pane
  local right
  moved=""
  right=$(call session.snapshot | jq -r --arg t "$1" --arg mode "${2:-}" '
    .result.snapshot as $s
    | ([$s.tabs[]? | select(.tab_id == $t)] | first) as $tab
    | if $tab == null or $s.focused_tab_id != $t
        or ($mode == "pane" and ($tab.pane_count // 1) > 1) then ""
      else
        [$s.tabs[] | select(.workspace_id == $tab.workspace_id) | .tab_id] as $ids
        | ($ids | index($t)) as $i
        | ($ids[$i + 1] // "")
      end')
  [ -n "$right" ] || return 0
  call tab.focus "{\"tab_id\":\"$right\"}" | jq -e '.error == null' >/dev/null &&
    moved=", focused $right"
}

close_pane() { # [pane_id]
  local pane="${1:-}" agent tab
  if [ -n "$pane" ]; then
    read -r pane agent tab < <(call pane.get "{\"pane_id\":\"$pane\"}" |
      jq -r '.result.pane | "\(.pane_id // "") \(.agent // "-") \(.tab_id // "")"')
  else
    read -r pane agent tab < <(call pane.current |
      jq -r '.result.pane | "\(.pane_id // "") \(.agent // "-") \(.tab_id // "")"')
  fi
  [ -n "${pane:-}" ] || die "no pane to close${1:+ ($1)}"
  # "-" holds the agent's place so read keeps tab_id in its own field.
  [ "${agent:-}" = "-" ] && agent=""
  killed=" none"
  [ -z "${agent:-}" ] || kill_agents "$pane"
  [ -z "${tab:-}" ] || focus_right_of "$tab" pane
  call pane.close "{\"pane_id\":\"$pane\"}" | jq -e '.error == null' >/dev/null ||
    die "pane close $pane failed"
  log "closed pane $pane${agent:+ ($agent)} (killed groups:$killed$moved)"
}

close_tab() { # [tab_id]
  local tab="${1:-}" agents
  # One snapshot answers both questions: which tab is focused, and which of
  # its panes hold agents. Editors and shells are left to the HUP.
  read -r tab agents < <(call session.snapshot | jq -r --arg t "$tab" '
    .result.snapshot as $s
    | (if $t == "" then ($s.focused_tab_id // "") else $t end) as $tab
    | [$tab] + [$s.panes[]? | select(.tab_id == $tab and ((.agent // "") != "")) | .pane_id]
    | join(" ")')
  [ -n "${tab:-}" ] || die "no focused tab"
  # shellcheck disable=SC2086 # pane ids carry no spaces; split them on purpose
  kill_agents $agents
  focus_right_of "$tab"
  call tab.close "{\"tab_id\":\"$tab\"}" | jq -e '.error == null' >/dev/null ||
    die "tab close $tab failed"
  log "closed tab $tab (killed groups:$killed$moved)"
}

# Ids go into JSON by hand, so only let through what Herdr ids look like.
case "${2:-}" in
  *[!A-Za-z0-9:_-]*) die "bad id: $2" ;;
esac

case "${1:-}" in
  pane) close_pane "${2:-}" ;;
  tab) close_tab "${2:-}" ;;
  *) die "usage: herdr-close pane|tab [<id>]" ;;
esac
