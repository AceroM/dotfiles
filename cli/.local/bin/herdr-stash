#!/usr/bin/env python3
"""Stash a Herdr space: write its agents to a Markdown table.

    herdr-stash                  the space this pane is in (else the focused one)
    herdr-stash --workspace w1C  a specific space
    herdr-stash --snapshot -     read a session.snapshot response from stdin
                                 instead of asking the socket (Hammerspoon's fn+\\
                                 passes the one it already fetched, from the
                                 socket of the Herdr client in Ghostty)

Writes ~/.local/share/herdr-stash/<date>-<time>-<space>.md (override the folder
with HERDR_STASH_DIR), one row per agent:

    | session id | agent | title | cwd |

cwd is there because `claude --resume <id>` only finds a session from the
directory it ran in. Prints the file's path on stdout and a one-line summary on
stderr. Nothing in the space is closed or changed.

Standard library only: Hammerspoon runs it with /usr/bin/python3.
"""

import argparse
import datetime
import glob
import json
import os
import re
import socket
import subprocess
import sys

HOME = os.path.expanduser("~")


def fail(message):
    print(f"herdr-stash: {message}", file=sys.stderr)
    sys.exit(1)


def socket_path():
    for name in ("HERDR_SOCKET_PATH", "HERDR_SOCKET"):
        if os.environ.get(name):
            return os.environ[name]
    return os.path.join(HOME, ".config/herdr/herdr.sock")


def request(method, params=None):
    line = json.dumps({"id": "stash", "method": method, "params": params or {}}) + "\n"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(3)
        conn.connect(socket_path())
        conn.sendall(line.encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data or b"{}")


def snapshot_from(response):
    snap = (response.get("result") or {}).get("snapshot")
    if not snap:
        error = response.get("error") or {}
        fail(f"no snapshot from Herdr ({error.get('message') or error.get('code') or 'empty response'})")
    return snap


def read_head_line(path):
    try:
        with open(path, "r", errors="replace") as file:
            return json.loads(file.readline())
    except (OSError, ValueError):
        return None


def read_tail(path, size=1024 * 1024):
    try:
        with open(path, "rb") as file:
            file.seek(0, os.SEEK_END)
            file.seek(max(0, file.tell() - size))
            return file.read().decode("utf8", "replace")
    except OSError:
        return ""


def session_from_path(kind, path):
    if kind == "claude":
        return os.path.basename(path).removesuffix(".jsonl")
    record = read_head_line(path)
    payload = record.get("payload") if isinstance(record, dict) else None
    return payload.get("id") if isinstance(payload, dict) else None


def process_agent(process):
    argv = process.get("argv") or []
    for executable in (process.get("name"), process.get("argv0"), argv[0] if argv else None):
        name = os.path.basename(executable or "")
        if name in ("claude", "codex"):
            return name
    script = argv[1] if len(argv) > 1 else ""
    if script.endswith("/@anthropic-ai/claude-code/cli.js"):
        return "claude"
    if script.endswith("/@openai/codex/bin/codex.js"):
        return "codex"
    return None


def session_from_process(pane_id, kind):
    """Agents started without Herdr's session hook: ask the process itself.

    Claude's PID registry first, then whichever transcript the process holds
    open. Never cwd/mtime: several agents can share one directory.
    """
    try:
        info = (request("pane.process_info", {"pane_id": pane_id}).get("result") or {}).get("process_info") or {}
    except (OSError, ValueError):
        return None
    pids = []
    for process in info.get("foreground_processes") or []:
        if process_agent(process) == kind and process.get("pid"):
            pids.append(str(process["pid"]))
            if kind == "claude":
                try:
                    with open(os.path.join(HOME, ".claude/sessions", f"{process['pid']}.json")) as file:
                        record = json.load(file)
                    if record.get("pid") == process["pid"] and record.get("sessionId"):
                        return record["sessionId"]
                except (OSError, ValueError):
                    pass
    if not pids:
        return None
    try:
        output = subprocess.run(
            ["/usr/sbin/lsof", "-nP", "-a", "-p", ",".join(pids), "-Fn"],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    pattern = r"/rollout-[^/]+\.jsonl$" if kind == "codex" else r"/\.claude/projects/[^/]+/[^/]+\.jsonl$"
    for line in output.splitlines():
        if line.startswith("n") and re.search(pattern, line):
            found = session_from_path(kind, line[1:])
            if found:
                return found
    return None


def last_json_string(text, key):
    found = None
    for match in re.finditer(rf'"{key}":"((?:[^"\\]|\\.)*)"', text):
        found = match.group(1)
    if found is None:
        return ""
    try:
        return json.loads(f'"{found}"')
    except ValueError:
        return found


def transcript_title(kind, session):
    """The session's own title, for an agent whose terminal hasn't set one."""
    if kind == "claude":
        for path in glob.glob(os.path.join(HOME, ".claude/projects/*", f"{session}.jsonl")):
            tail = read_tail(path)
            title = last_json_string(tail, "customTitle") or last_json_string(tail, "aiTitle")
            if title:
                return title
    elif kind == "codex":
        title = ""
        try:
            with open(os.path.join(HOME, ".codex/session_index.jsonl"), errors="replace") as file:
                for line in file:
                    if session in line:
                        try:
                            record = json.loads(line)
                        except ValueError:
                            continue
                        if record.get("id") == session and record.get("thread_name"):
                            title = record["thread_name"]  # append-only: last rename wins
        except OSError:
            pass
        return title
    return ""


def clean(value):
    return re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", value or "")).strip()


def cell(value):
    return clean(value).replace("|", "\\|") or "—"


def tilde(path):
    return "~" + path[len(HOME):] if path and (path == HOME or path.startswith(HOME + "/")) else path or ""


def slug(value):
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-") or "space"


def main():
    parser = argparse.ArgumentParser(description="Write a Herdr space's agents to a Markdown table.")
    parser.add_argument("--workspace", help="space id (default: this pane's space, else the focused one)")
    parser.add_argument("--snapshot", help="'-' to read a session.snapshot response from stdin")
    args = parser.parse_args()

    if args.snapshot == "-":
        try:
            snap = snapshot_from(json.loads(sys.stdin.read()))
        except ValueError:
            fail("stdin is not a session.snapshot response")
    elif args.snapshot:
        fail("--snapshot only takes '-'")
    else:
        try:
            snap = snapshot_from(request("session.snapshot"))
        except (OSError, ValueError) as error:
            fail(f"can't reach Herdr at {socket_path()}: {error}")

    workspace_id = args.workspace or os.environ.get("HERDR_WORKSPACE_ID") or snap.get("focused_workspace_id")
    space = next((w for w in snap.get("workspaces") or [] if w.get("workspace_id") == workspace_id), None)
    if not space:
        fail(f"no space {workspace_id!r} in this Herdr session")
    label = space.get("label") or workspace_id

    # Snapshot arrays follow display order: sort agents by their tab's position.
    tabs = [t for t in snap.get("tabs") or [] if t.get("workspace_id") == workspace_id]
    tab_order = {t["tab_id"]: i for i, t in enumerate(tabs)}
    agents = [a for a in snap.get("agents") or [] if a.get("workspace_id") == workspace_id]
    agents.sort(key=lambda a: tab_order.get(a.get("tab_id"), len(tab_order)))
    if not agents:
        fail(f"no agents in space {label}")

    rows = []
    for agent in agents:
        kind = agent.get("agent") or "?"
        meta = agent.get("agent_session") or {}
        value = meta.get("value") if isinstance(meta.get("value"), str) else None
        if value and meta.get("kind") == "path":
            session = session_from_path(kind, value)
        else:
            session = value
        if not session and kind in ("claude", "codex"):
            session = session_from_process(agent.get("pane_id"), kind)
        title = agent.get("terminal_title_stripped") or (session and transcript_title(kind, session)) or ""
        cwd = agent.get("foreground_cwd") or agent.get("cwd") or ""
        rows.append((session or "", kind, title, cwd))

    now = datetime.datetime.now()
    out_dir = os.environ.get("HERDR_STASH_DIR") or os.path.join(HOME, ".local/share/herdr-stash")
    os.makedirs(out_dir, exist_ok=True)
    path = os.path.join(out_dir, f"{now:%Y-%m-%d-%H%M%S}-{slug(label)}.md")

    lines = [
        f"# {clean(label)}",
        "",
        f"Stashed {now:%Y-%m-%d %H:%M} from Herdr space `{workspace_id}`.",
        "",
        "| session id | agent | title | cwd |",
        "| --- | --- | --- | --- |",
    ]
    lines += [f"| {cell(s)} | {cell(k)} | {cell(t)} | {cell(tilde(c))} |" for s, k, t, c in rows]
    with open(path, "w") as file:
        file.write("\n".join(lines) + "\n")

    missing = sum(1 for s, *_ in rows if not s)
    note = f", {missing} without a session id" if missing else ""
    noun = "agent" if len(rows) == 1 else "agents"
    print(f"Stashed {len(rows)} {noun} from {clean(label)}{note}", file=sys.stderr)
    print(path)


if __name__ == "__main__":
    main()
