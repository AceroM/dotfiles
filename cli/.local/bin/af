#!/usr/bin/env bash
# af — the HTML pages agents write, newest first.
#
#   af              the 5 most recently changed pages, numbered
#   af <n>          open page n in Chrome (focuses and reloads its tab if it's already open)
#   af ls [count]   list more (all of them by default)
#   af path <n>     print page n's path:  nvim "$(af path 1)"
#   af <file>       open any HTML file the same way
#   af dir          print the pages directory
#
# A page is a plain .html file at the top of $AF_DIR (default ~/artifacts). Agents write
# them there and nothing else keeps state: the list is just the directory sorted by
# modification time, so a page an agent rewrites moves back to 1.
#
# Vimium only runs on file:// pages once "Allow access to file URLs" is on for it in
# chrome://extensions/?id=dbepggeogbaibhgnhhndojpepiihcmeb.
set -euo pipefail

dir="${AF_DIR:-$HOME/artifacts}"

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

# "mtime<TAB>path" per page, newest first.
pages() {
  [ -d "$dir" ] || return 0
  find "$dir" -maxdepth 1 -type f -name '*.html' -exec stat -f '%m	%N' {} + | sort -rn
}

title() {
  local t
  t=$(LC_ALL=C grep -io -m1 '<title[^>]*>[^<]*' "$1" 2>/dev/null | head -1 | sed -e 's/<[^>]*>//' \
    -e 's/&amp;/\&/g' -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e "s/&#39;/'/g" \
    -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//') || true
  if [ -n "$t" ]; then printf '%s' "$t"; else basename "$1" .html; fi
}

ago() {
  local s=$(( $(date +%s) - $1 ))
  if   (( s < 60 ));    then echo "now"
  elif (( s < 3600 ));  then echo "$(( s / 60 ))m"
  elif (( s < 86400 )); then echo "$(( s / 3600 ))h"
  else                       echo "$(( s / 86400 ))d"
  fi
}

list() {
  local limit=$1 n=0 mtime path dim="" off=""
  if [ -t 1 ]; then dim=$'\e[2m'; off=$'\e[0m'; fi
  while IFS=$'\t' read -r mtime path; do
    n=$(( n + 1 ))
    (( limit > 0 && n > limit )) && break
    printf '%3d  %-4s %s  %s%s%s\n' "$n" "$(ago "$mtime")" "$(title "$path")" "$dim" "$(basename "$path")" "$off"
  done < <(pages)
  if (( n == 0 )); then
    echo "No pages in $dir yet."
  elif (( limit > 0 )); then
    local total; total=$(pages | wc -l | tr -d ' ')
    (( total > limit )) && echo "${dim}     … $(( total - limit )) more: af ls${off}"
  fi
  return 0
}

nth() {
  local path=""
  (( $1 >= 1 )) && path=$(pages | sed -n "${1}p" | cut -f2-)
  [ -n "$path" ] || { echo "af: no page $1 (af ls lists them)" >&2; exit 1; }
  printf '%s' "$path"
}

# Bring an open tab showing the file forward and reload it; otherwise open a new one.
open_page() {
  local path url
  path=$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")
  url="file://$path"
  if osascript - "$url" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set target to item 1 of argv
  tell application "Google Chrome"
    repeat with w in windows
      set i to 0
      repeat with t in tabs of w
        set i to i + 1
        if URL of t is target then
          set active tab index of w to i
          set index of w to 1
          tell t to reload
          activate
          return
        end if
      end repeat
    end repeat
  end tell
  error "not open"
end run
APPLESCRIPT
  then
    return 0
  fi
  open -a "Google Chrome" "$path"
}

case "${1:-}" in
  "")            list 5 ;;
  -h|--help|help) usage ;;
  ls)            list "${2:-0}" ;;
  dir)           echo "$dir" ;;
  path)          [ -n "${2:-}" ] || { usage >&2; exit 2; }; page=$(nth "$2") || exit 1; echo "$page" ;;
  *[!0-9]*)      [ -f "$1" ] || { echo "af: no such page or file: $1" >&2; exit 1; }; open_page "$1" ;;
  *)             page=$(nth "$1") || exit 1; open_page "$page" ;;
esac
