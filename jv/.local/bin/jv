#!/usr/bin/env bash
# All five command names point here. Keep the invoked name across Stow links.
set -euo pipefail
name="${0##*/}"
script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
  dir="$(cd -P -- "$(dirname -- "$script")" && pwd)"
  script="$(readlink "$script")"
  [[ "$script" = /* ]] || script="$dir/$script"
done
app_dir="$(cd -- "$(cd -P -- "$(dirname -- "$script")" && pwd)/../share/jv" && pwd)"
bin="$app_dir/target/jv"

if [[ ! -x "$bin" ]] || [[ -n "$(find -L "$app_dir/cmd" "$app_dir"/go.* -newer "$bin" -print -quit)" ]]; then
  command -v go >/dev/null || { printf '%s\n' 'jv: Go is required to build the CLI.' >&2; exit 1; }
  mkdir -p "$app_dir/target"
  tmp="$(mktemp "$app_dir/target/jv.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  (cd "$app_dir" && go build -trimpath -o "$tmp" ./cmd/jv) >&2
  mv -f "$tmp" "$bin"
  trap - EXIT
fi

export _JV_VIEWER="${_JV_VIEWER:-$app_dir/viewer.sh}"
exec -a "$name" "$bin" "$@"
