[
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile"
    }
  },
  {
    "context": "ProjectSearch",
    "bindings": {}
  },
  {
    "context": "FileFinder",
    "bindings": {}
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "file_finder::Toggle",
      "alt-shift-c": "workspace::CopyRelativePath",
      "alt-s": "workspace::Save",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-;": "workspace::ToggleRightDock",
      "alt-f": "workspace::NewSearch"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-o": "file_finder::Toggle",
      "alt-shift-t": "pane::ReopenClosedItem",
      "alt-i": "workspace::ActivateNextPane",
      "alt-[": "pane::ActivatePreviousItem",
      "alt-]": "pane::ActivateNextItem",
      "alt-w": "pane::CloseActiveItem",
      "ctrl-shift-w": "pane::CloseAllItems"
    }
  },
  {
    "context": "AssistantPanel",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-d": "editor::SelectNext",
      "alt-p": "command_palette::Toggle",
      "alt-shift-k": "editor::DuplicateLineUp",
      "alt-shift-j": "editor::DuplicateLineDown",
      "alt-shift-w": "workspace::CloseInactiveTabsAndPanes",
      "alt-x": "editor::Cut",
      "alt-v": "editor::Paste",
      "alt-c": "editor::Copy",
      "alt-shift-p": "editor::GoToPreviousDiagnostic",
      "alt-n": "editor::GoToDiagnostic",
      "cmd-backspace": "editor::DeleteLine",
      "alt-j": "editor::SelectLargerSyntaxNode",
      "alt-shift-d": "editor::FindAllReferences",
      "alt-m": "editor::GoToDefinitionSplit",
      "ctrl-alt-enter": "editor::NewlineAbove",
      "shift-enter": "editor::NewlineBelow",
      "alt-a": "editor::SelectAll",
      "alt-z": "editor::Undo",
      "alt-k": "assistant::InlineAssist",
      "alt-shift-g": "search::SelectPreviousMatch",
      "alt-g": "search::SelectNextMatch",
      "alt-h": "editor::Hover",
      "alt-enter": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "g l": "editor::SelectNext",
      "g a": "editor::SelectAllMatches",
      "g r": "editor::FindAllReferences",
      "g ;": "editor::Rename"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-cmd-shift-r": "task::Spawn"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-alt-cmd-r": "task::Spawn"
    }
  },
  {
    "bindings": {
      "cmd-shift-r": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "bindings": {
      "ctrl-alt-p": "editor::OpenPermalinkToLine"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "bindings": {
      "cmd-i": "terminal_panel::ToggleFocus",
      "ctrl-alt-j": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-cmd-d": "debug_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-d": "git::Diff"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-g d": null
    }
  },
  {
    "bindings": {
      "alt-/": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      // Match Ghostty's Shift+Enter CSI-u sequence so Codex inserts a newline.
      "shift-enter": ["terminal::SendText", "\u001b[13;2u"],
      "cmd-;": ["workspace::SendKeystrokes", "cmd-i alt-/ cmd-i cmd-v"],
      "cmd-'": ["workspace::SendKeystrokes", "cmd-i cmd-; cmd-i cmd-v"],
      "ctrl-alt-down": null,
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-a": null,
      "ctrl-e": null,
      "alt-backspace": ["terminal::SendKeystroke", "ctrl-w"],
      "ctrl-alt-k": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "ctrl-alt-down": "editor::GoToNextChange"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-l": ["editor::InsertSnippet", { "snippet": "console.log($1);" }]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-d": ["editor::InsertSnippet", { "snippet": "debugger;" }],
      "ctrl-c": ["editor::InsertSnippet", { "snippet": "const $1" }],
      "ctrl-r": ["editor::InsertSnippet", { "snippet": "return $1" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-up": "vim::ScrollUp",
      "alt-down": "vim::ScrollDown",
      "alt-shift-up": "editor::MoveLineUp",
      "alt-shift-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "alt-enter": "editor::OpenExcerpts"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g space": "editor::OpenExcerpts"
    }
  },
  {
    "bindings": {
      "g cmd-d": "git::BranchDiff"
    }
  },
  {
    "bindings": {
      "cmd-5": "editor::RestartLanguageServer"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-alt-;": "workspace::ToggleRightDock"
    }
  },
  {
    "bindings": {
      "cmd-shift-.": "editor::ToggleFocus"
    }
  },
  {
    "bindings": {
      "alt-cmd-n": "agent::NewThread"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "bindings": {
      "cmd-;": "editor::CopyFileLocation"
    }
  },
  // Helper for the visual-mode ctrl-l below; not meant to be pressed directly.
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-cmd-shift-l": [
        "editor::InsertSnippet",
        { "snippet": "console.log('$1 :>>', $2);" }
      ]
    }
  },
  // Select a variable, hit ctrl-l -> logs it on the line below.
  // copy | leave visual | open line below | template | fill both tabstops
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-l": [
        "workspace::SendKeystrokes",
        "cmd-c escape o ctrl-alt-cmd-shift-l cmd-v tab cmd-v escape"
      ]
    }
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "v": "editor::SelectLargerSyntaxNode",
      "V": "editor::SelectSmallerSyntaxNode"
    }
  }
]
