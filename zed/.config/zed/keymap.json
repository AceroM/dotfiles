[
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      // Preview the file in a tab but keep the cursor here in the tree, unlike
      // enter/OpenPermanent which focuses the editor. On a directory this
      // toggles it open/closed.
      "l": "project_panel::Open",

      // Scroll the open file instead of the tree. vim::Scroll* live on the
      // editor, so we hop focus there, scroll, and hop back -- SendKeystrokes
      // redraws and yields whenever a keystroke moves focus, so each step lands
      // in the right context. See the helpers below.
      "ctrl-d": [
        "workspace::SendKeystrokes",
        "ctrl-alt-cmd-shift-f ctrl-alt-cmd-shift-d ctrl-alt-cmd-shift-f"
      ],
      "ctrl-u": [
        "workspace::SendKeystrokes",
        "ctrl-alt-cmd-shift-f ctrl-alt-cmd-shift-u ctrl-alt-cmd-shift-f"
      ]
    }
  },
  // Helpers for the project panel ctrl-d/ctrl-u above; not meant to be pressed
  // directly. The focus hop is global so it fires from either side; the scrolls
  // are bound to the actions rather than the raw keys so a buffer sitting in
  // insert mode doesn't outdent or delete instead.
  {
    "bindings": {
      "ctrl-alt-cmd-shift-f": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-alt-cmd-shift-d": "vim::ScrollDown",
      "ctrl-alt-cmd-shift-u": "vim::ScrollUp"
    }
  },
  {
    "context": "ProjectSearch",
    "bindings": {}
  },
  {
    "context": "FileFinder",
    "bindings": {}
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "file_finder::Toggle",
      "alt-shift-c": "workspace::CopyRelativePath",
      "alt-s": "workspace::Save",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-;": "workspace::ToggleRightDock",
      "alt-f": "workspace::NewSearch"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-o": "file_finder::Toggle",
      "alt-shift-t": "pane::ReopenClosedItem",
      "alt-i": "workspace::ActivateNextPane",
      "alt-[": "pane::ActivatePreviousItem",
      "alt-]": "pane::ActivateNextItem",
      "ctrl-shift-w": "pane::CloseAllItems"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-d": "editor::SelectNext",
      "alt-t": "editor::WrapSelectionsInTag",
      "alt-p": "command_palette::Toggle",
      "alt-shift-k": "editor::DuplicateLineUp",
      "alt-shift-j": "editor::DuplicateLineDown",
      "alt-shift-w": "workspace::CloseInactiveTabsAndPanes",
      "alt-x": "editor::Cut",
      "alt-v": "editor::Paste",
      "alt-c": "editor::Copy",
      "alt-shift-p": "editor::GoToPreviousDiagnostic",
      "alt-n": "editor::GoToDiagnostic",
      "cmd-backspace": "editor::DeleteLine",
      "alt-j": "editor::SelectLargerSyntaxNode",
      "alt-shift-d": "editor::FindAllReferences",
      "alt-m": "editor::GoToDefinitionSplit",
      // Takes cmd-d off SelectNext, which alt-d above already covers.
      "cmd-d": "editor::GoToDefinition",
      "ctrl-alt-enter": "editor::NewlineAbove",
      "shift-enter": "editor::NewlineBelow",
      "alt-a": "editor::SelectAll",
      "alt-z": "editor::Undo",
      "alt-shift-g": "search::SelectPreviousMatch",
      "alt-g": "search::SelectNextMatch",
      "alt-h": "editor::Hover",
      "alt-enter": "editor::ToggleCodeActions",
      "alt-w": "editor::ToggleSoftWrap"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "g l": "editor::SelectNext",
      "g a": "editor::SelectAllMatches",
      "g r": "editor::FindAllReferences",
      "g ;": "editor::Rename"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-cmd-shift-r": "task::Spawn"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-alt-cmd-r": "task::Spawn"
    }
  },
  {
    "bindings": {
      "cmd-shift-r": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "bindings": {
      "ctrl-alt-p": "editor::OpenPermalinkToLine"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  // ToggleFocus round-trips between the bottom-docked terminal panel and the
  // last center pane without depending on pane numbers; the cmd-; and cmd-'
  // chains below use it for the same reason.
  {
    "bindings": {
      "cmd-i": "terminal_panel::ToggleFocus",
      "ctrl-alt-j": "terminal_panel::ToggleFocus",
      "ctrl-alt-cmd-i": "workspace::NewCenterTerminal"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-cmd-d": "debug_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "f5": "debugger::Start",
      "ctrl-alt-cmd-s": "debugger::Start",
      "shift-f5": "debugger::Stop",
      "cmd-shift-f5": "debugger::Rerun",
      "f8": "debugger::Continue",
      "alt-shift-n": "debugger::Continue",
      "f10": "debugger::StepOver",
      "alt-shift-o": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "alt-shift-i": "debugger::StepInto",
      "shift-f11": "debugger::StepOut",
      "alt-shift-u": "debugger::StepOut",
      "alt-shift-r": "debugger::RunToCursor"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "f9": "editor::ToggleBreakpoint",
      "alt-shift-b": "editor::ToggleBreakpoint"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-d": "git::Diff"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-g d": null
    }
  },
  {
    "bindings": {
      "alt-/": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b[13;2u"],
      "ctrl-;": ["terminal::SendText", "\u001b[59;5u"],
      "cmd-;": ["workspace::SendKeystrokes", "cmd-i alt-/ cmd-i cmd-v"],
      "cmd-'": ["workspace::SendKeystrokes", "cmd-i cmd-; cmd-i cmd-v"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-a": null,
      "ctrl-e": null,
      "alt-backspace": ["terminal::SendKeystroke", "ctrl-w"]
    }
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "ctrl-alt-down": "editor::GoToNextChange"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-l": ["editor::InsertSnippet", { "snippet": "console.log($1);" }]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-d": ["editor::InsertSnippet", { "snippet": "debugger;" }],
      "ctrl-c": ["editor::InsertSnippet", { "snippet": "const $1" }],
      "ctrl-r": ["editor::InsertSnippet", { "snippet": "return $1" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "alt-enter": "editor::OpenExcerpts"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g space": "editor::OpenExcerpts"
    }
  },
  {
    "bindings": {
      "g cmd-d": "git::BranchDiff"
    }
  },
  {
    "bindings": {
      "cmd-5": "editor::RestartLanguageServer"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-alt-;": "workspace::ToggleRightDock"
    }
  },
  {
    "bindings": {
      "cmd-shift-.": "editor::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "bindings": {
      "cmd-;": "editor::CopyFileLocation"
    }
  },
  // Helper for the visual-mode ctrl-l below; not meant to be pressed directly.
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-cmd-shift-l": [
        "editor::InsertSnippet",
        { "snippet": "console.log('$1 :>>', $2);" }
      ]
    }
  },
  // Select a variable, hit ctrl-l -> logs it on the line below.
  // copy | leave visual | open line below | template | fill both tabstops
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-l": [
        "workspace::SendKeystrokes",
        "cmd-c escape o ctrl-alt-cmd-shift-l cmd-v tab cmd-v escape"
      ]
    }
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "v": "editor::SelectLargerSyntaxNode",
      "V": "editor::SelectSmallerSyntaxNode",
      // Don't use vim marks, so ' is free for the text finder.
      "'": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-f": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "alt-f": "text_finder::Toggle"
    }
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  },
  // Vim H/L switch tabs instead of jumping to the top/bottom of the viewport.
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem"
    }
  },
  // Extend the default search motions, then center before the next redraw.
  // SendKeystrokes falls through to the default n/N binding rather than recursing.
  {
    "context": "Editor && mode == full && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "n": ["workspace::SendKeystrokes", "n z z"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z"]
    }
  }
]
