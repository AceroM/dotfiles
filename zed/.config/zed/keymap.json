[
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      // Preview the file in a tab but keep the cursor here in the tree, unlike
      // enter/OpenPermanent which focuses the editor. On a directory this
      // toggles it open/closed.
      "l": "project_panel::Open",

      // Scroll the open file instead of the tree. vim::Scroll* live on the
      // editor, so we hop focus there, scroll, and hop back -- SendKeystrokes
      // redraws and yields whenever a keystroke moves focus, so each step lands
      // in the right context. See the helpers below.
      "ctrl-d": [
        "workspace::SendKeystrokes",
        "ctrl-alt-cmd-shift-f ctrl-alt-cmd-shift-d ctrl-alt-cmd-shift-f"
      ],
      "ctrl-u": [
        "workspace::SendKeystrokes",
        "ctrl-alt-cmd-shift-f ctrl-alt-cmd-shift-u ctrl-alt-cmd-shift-f"
      ]
    }
  },
  // Helpers for the project panel ctrl-d/ctrl-u above; not meant to be pressed
  // directly. The focus hop is global so it fires from either side; the scrolls
  // are bound to the actions rather than the raw keys so a buffer sitting in
  // insert mode doesn't outdent or delete instead.
  {
    "bindings": {
      "ctrl-alt-cmd-shift-f": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-alt-cmd-shift-d": "vim::ScrollDown",
      "ctrl-alt-cmd-shift-u": "vim::ScrollUp"
    }
  },
  {
    "context": "ProjectSearch",
    "bindings": {}
  },
  {
    "context": "FileFinder",
    "bindings": {}
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "file_finder::Toggle",
      "alt-shift-c": "workspace::CopyRelativePath",
      "alt-s": "workspace::Save",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-;": "workspace::ToggleRightDock",
      "alt-f": "workspace::NewSearch"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-o": "file_finder::Toggle",
      "alt-shift-t": "pane::ReopenClosedItem",
      "alt-i": "workspace::ActivateNextPane",
      "alt-[": "pane::ActivatePreviousItem",
      "alt-]": "pane::ActivateNextItem",
      "ctrl-shift-w": "pane::CloseAllItems"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-d": "editor::SelectNext",
      "alt-t": "editor::WrapSelectionsInTag",
      "alt-p": "command_palette::Toggle",
      "alt-shift-k": "editor::DuplicateLineUp",
      "alt-shift-j": "editor::DuplicateLineDown",
      "alt-shift-w": "workspace::CloseInactiveTabsAndPanes",
      "alt-x": "editor::Cut",
      "alt-v": "editor::Paste",
      "alt-c": "editor::Copy",
      "alt-shift-p": "editor::GoToPreviousDiagnostic",
      "alt-n": "editor::GoToDiagnostic",
      "cmd-backspace": "editor::DeleteLine",
      "alt-j": "editor::SelectLargerSyntaxNode",
      "alt-shift-d": "editor::FindAllReferences",
      "alt-m": "editor::GoToDefinitionSplit",
      // Takes cmd-d off SelectNext, which alt-d above already covers.
      "cmd-d": "editor::GoToDefinition",
      "ctrl-alt-enter": "editor::NewlineAbove",
      "shift-enter": "editor::NewlineBelow",
      "alt-a": "editor::SelectAll",
      "alt-z": "editor::Undo",
      "alt-shift-g": "search::SelectPreviousMatch",
      "alt-g": "search::SelectNextMatch",
      "alt-h": "editor::Hover",
      "alt-enter": "editor::ToggleCodeActions",
      "alt-w": "editor::ToggleSoftWrap"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "g l": "editor::SelectNext",
      "g a": "editor::SelectAllMatches",
      "g r": "editor::FindAllReferences",
      "g ;": "editor::Rename"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-cmd-shift-r": "task::Spawn"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "ctrl-alt-cmd-r": "task::Spawn"
    }
  },
  {
    "bindings": {
      "cmd-shift-r": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "bindings": {
      "ctrl-alt-p": "editor::OpenPermalinkToLine"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "bindings": {
      "cmd-i": "terminal_panel::ToggleFocus",
      "ctrl-alt-j": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-cmd-d": "debug_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "f5": "debugger::Start",
      "ctrl-alt-cmd-s": "debugger::Start",
      "shift-f5": "debugger::Stop",
      "cmd-shift-f5": "debugger::Rerun",
      "f8": "debugger::Continue",
      "alt-shift-n": "debugger::Continue",
      "f10": "debugger::StepOver",
      "alt-shift-o": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "alt-shift-i": "debugger::StepInto",
      "shift-f11": "debugger::StepOut",
      "alt-shift-u": "debugger::StepOut",
      "alt-shift-r": "debugger::RunToCursor"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "f9": "editor::ToggleBreakpoint",
      "alt-shift-b": "editor::ToggleBreakpoint"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-d": "git::Diff"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-g d": null
    }
  },
  {
    "bindings": {
      "alt-/": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b[13;2u"],
      "ctrl-;": ["terminal::SendText", "\u001b[59;5u"],
      "cmd-;": ["workspace::SendKeystrokes", "cmd-i alt-/ cmd-i cmd-v"],
      "cmd-'": ["workspace::SendKeystrokes", "cmd-i cmd-; cmd-i cmd-v"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-a": null,
      "ctrl-e": null,
      "alt-backspace": ["terminal::SendKeystroke", "ctrl-w"],

      // Herdr enables the kitty keyboard protocol, but Zed's terminal does not
      // currently encode character chords with their full modifier set. Send
      // the CSI-u sequences Herdr would receive from Ghostty explicitly.

      // ctrl+alt direct actions (CSI-u modifier 7)
      "ctrl-alt-b": ["terminal::SendText", "\u001b[98;7u"],
      "ctrl-alt-h": ["terminal::SendText", "\u001b[104;7u"],
      "ctrl-alt-i": ["terminal::SendText", "\u001b[105;7u"],
      "ctrl-alt-j": ["terminal::SendText", "\u001b[106;7u"],
      "ctrl-alt-k": ["terminal::SendText", "\u001b[107;7u"],
      "ctrl-alt-l": ["terminal::SendText", "\u001b[108;7u"],
      "ctrl-alt-n": ["terminal::SendText", "\u001b[110;7u"],
      "ctrl-alt-r": ["terminal::SendText", "\u001b[114;7u"],
      "ctrl-alt-u": ["terminal::SendText", "\u001b[117;7u"],
      "ctrl-alt-v": ["terminal::SendText", "\u001b[118;7u"],
      "ctrl-alt-w": ["terminal::SendText", "\u001b[119;7u"],
      "ctrl-alt-x": ["terminal::SendText", "\u001b[120;7u"],
      "ctrl-alt-z": ["terminal::SendText", "\u001b[122;7u"],
      "ctrl-alt--": ["terminal::SendText", "\u001b[45;7u"],
      "ctrl-alt-;": ["terminal::SendText", "\u001b[59;7u"],

      // ctrl+alt pane focus uses the modified xterm/kitty arrow encoding.
      "ctrl-alt-left": ["terminal::SendText", "\u001b[1;7D"],
      "ctrl-alt-down": ["terminal::SendText", "\u001b[1;7B"],
      "ctrl-alt-up": ["terminal::SendText", "\u001b[1;7A"],
      "ctrl-alt-right": ["terminal::SendText", "\u001b[1;7C"],

      // ctrl+alt+1..9 switches Herdr tabs.
      "ctrl-alt-1": ["terminal::SendText", "\u001b[49;7u"],
      "ctrl-alt-2": ["terminal::SendText", "\u001b[50;7u"],
      "ctrl-alt-3": ["terminal::SendText", "\u001b[51;7u"],
      "ctrl-alt-4": ["terminal::SendText", "\u001b[52;7u"],
      "ctrl-alt-5": ["terminal::SendText", "\u001b[53;7u"],
      "ctrl-alt-6": ["terminal::SendText", "\u001b[54;7u"],
      "ctrl-alt-7": ["terminal::SendText", "\u001b[55;7u"],
      "ctrl-alt-8": ["terminal::SendText", "\u001b[56;7u"],
      "ctrl-alt-9": ["terminal::SendText", "\u001b[57;7u"],

      // ctrl+alt+shift direct actions (CSI-u modifier 8)
      "ctrl-alt-shift-j": ["terminal::SendText", "\u001b[106;8u"],
      "ctrl-alt-shift-k": ["terminal::SendText", "\u001b[107;8u"],
      "ctrl-alt-shift-n": ["terminal::SendText", "\u001b[110;8u"],
      "ctrl-alt-shift-r": ["terminal::SendText", "\u001b[114;8u"],
      "ctrl-alt-shift-w": ["terminal::SendText", "\u001b[119;8u"],

      // cmd+alt+shift+a..z focuses a Herdr space by its initial.
      "cmd-alt-shift-a": ["terminal::SendText", "\u001b[97;12u"],
      "cmd-alt-shift-b": ["terminal::SendText", "\u001b[98;12u"],
      "cmd-alt-shift-c": ["terminal::SendText", "\u001b[99;12u"],
      "cmd-alt-shift-d": ["terminal::SendText", "\u001b[100;12u"],
      "cmd-alt-shift-e": ["terminal::SendText", "\u001b[101;12u"],
      "cmd-alt-shift-f": ["terminal::SendText", "\u001b[102;12u"],
      "cmd-alt-shift-g": ["terminal::SendText", "\u001b[103;12u"],
      "cmd-alt-shift-h": ["terminal::SendText", "\u001b[104;12u"],
      "cmd-alt-shift-i": ["terminal::SendText", "\u001b[105;12u"],
      "cmd-alt-shift-j": ["terminal::SendText", "\u001b[106;12u"],
      "cmd-alt-shift-k": ["terminal::SendText", "\u001b[107;12u"],
      "cmd-alt-shift-l": ["terminal::SendText", "\u001b[108;12u"],
      "cmd-alt-shift-m": ["terminal::SendText", "\u001b[109;12u"],
      "cmd-alt-shift-n": ["terminal::SendText", "\u001b[110;12u"],
      "cmd-alt-shift-o": ["terminal::SendText", "\u001b[111;12u"],
      "cmd-alt-shift-p": ["terminal::SendText", "\u001b[112;12u"],
      "cmd-alt-shift-q": ["terminal::SendText", "\u001b[113;12u"],
      "cmd-alt-shift-r": ["terminal::SendText", "\u001b[114;12u"],
      "cmd-alt-shift-s": ["terminal::SendText", "\u001b[115;12u"],
      "cmd-alt-shift-t": ["terminal::SendText", "\u001b[116;12u"],
      "cmd-alt-shift-u": ["terminal::SendText", "\u001b[117;12u"],
      "cmd-alt-shift-v": ["terminal::SendText", "\u001b[118;12u"],
      "cmd-alt-shift-w": ["terminal::SendText", "\u001b[119;12u"],
      "cmd-alt-shift-x": ["terminal::SendText", "\u001b[120;12u"],
      "cmd-alt-shift-y": ["terminal::SendText", "\u001b[121;12u"],
      "cmd-alt-shift-z": ["terminal::SendText", "\u001b[122;12u"],

      // Zed represents Shift+digit as its punctuation character. Reattach the
      // shift bit in the bytes sent to Herdr (CSI-u modifier 12).
      "cmd-alt-!": ["terminal::SendText", "\u001b[49;12u"],
      "cmd-alt-@": ["terminal::SendText", "\u001b[50;12u"],
      "cmd-alt-#": ["terminal::SendText", "\u001b[51;12u"],
      "cmd-alt-$": ["terminal::SendText", "\u001b[52;12u"],
      "cmd-alt-%": ["terminal::SendText", "\u001b[53;12u"],
      "cmd-alt-^": ["terminal::SendText", "\u001b[54;12u"],
      "cmd-alt-&": ["terminal::SendText", "\u001b[55;12u"],
      "cmd-alt-*": ["terminal::SendText", "\u001b[56;12u"],
      "cmd-alt-(": ["terminal::SendText", "\u001b[57;12u"]
    }
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "ctrl-alt-down": "editor::GoToNextChange"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-l": ["editor::InsertSnippet", { "snippet": "console.log($1);" }]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-d": ["editor::InsertSnippet", { "snippet": "debugger;" }],
      "ctrl-c": ["editor::InsertSnippet", { "snippet": "const $1" }],
      "ctrl-r": ["editor::InsertSnippet", { "snippet": "return $1" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "alt-enter": "editor::OpenExcerpts"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g space": "editor::OpenExcerpts"
    }
  },
  {
    "bindings": {
      "g cmd-d": "git::BranchDiff"
    }
  },
  {
    "bindings": {
      "cmd-5": "editor::RestartLanguageServer"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-alt-;": "workspace::ToggleRightDock"
    }
  },
  {
    "bindings": {
      "cmd-shift-.": "editor::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "bindings": {
      "cmd-;": "editor::CopyFileLocation"
    }
  },
  // Helper for the visual-mode ctrl-l below; not meant to be pressed directly.
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-cmd-shift-l": [
        "editor::InsertSnippet",
        { "snippet": "console.log('$1 :>>', $2);" }
      ]
    }
  },
  // Select a variable, hit ctrl-l -> logs it on the line below.
  // copy | leave visual | open line below | template | fill both tabstops
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-l": [
        "workspace::SendKeystrokes",
        "cmd-c escape o ctrl-alt-cmd-shift-l cmd-v tab cmd-v escape"
      ]
    }
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "v": "editor::SelectLargerSyntaxNode",
      "V": "editor::SelectSmallerSyntaxNode",
      // Don't use vim marks, so ' is free for the text finder.
      "'": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-f": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "alt-f": "text_finder::Toggle"
    }
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  }
]
