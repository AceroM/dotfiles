{
  "manifest_version": 3,
  "name": "Quick Record HAR",
  "version": "1.0.0",
  "description": "Saves a HAR of the tabs on camera while Quick Record makes a demo recording (fn+⌥Q). Local only.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "webRequest", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Quick Record HAR" }
}
