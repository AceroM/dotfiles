#!/bin/bash
# o — a Go prompt that starts agents in new Rex tabs, with local drafts.
# Source lives in ~/.local/share/o (stowed from o/.local/share/o). Build on
# first run or source changes. Keep the public build in its own cache so
# checking this version cannot replace another installation's binary.
app_dir="${O_HOME:-$HOME/.local/share/o}"
bin="${XDG_CACHE_HOME:-$HOME/.cache}/o-public/o"

stale=
if [[ ! -x "$bin" ]]; then
  stale=1
else
  for f in "$app_dir"/*.go "$app_dir"/internal/*/*.go "$app_dir/go.mod" "$app_dir/go.sum"; do
    if [[ "$f" -nt "$bin" ]]; then
      stale=1
      break
    fi
  done
fi

if [[ -n "$stale" ]]; then
  if ! command -v go >/dev/null 2>&1; then
    printf '%s\n' 'o: Go 1.24 or newer is required to build o.' >&2
    exit 1
  fi
  printf '%s\n' 'o: building (first run or sources changed)…' >&2
  mkdir -p "${bin%/*}" || exit 1
  trap 'rm -f "$bin.tmp.$$"' EXIT
  go -C "$app_dir" build -trimpath -ldflags='-s -w' -o "$bin.tmp.$$" . >&2 || exit 1
  mv -f "$bin.tmp.$$" "$bin" || exit 1
fi

[[ ${1:-} == --build-only ]] && exit 0
exec "$bin" "$@"
